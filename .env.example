# Copy to .env and fill in. .env is gitignored.
# Which model backend serves LLM calls:
#   anthropic   (default) Anthropic API, needs ANTHROPIC_API_KEY, billed per token
#   claude-code runs the logged-in `claude` CLI (Claude subscription; run `claude login` once)
#   codex       runs the logged-in `codex` CLI (ChatGPT subscription)
#   grok        runs the logged-in Grok Build `grok` CLI (SuperGrok / X Premium+; run `grok login` once)
# CLI backends are for personal use on your own machine. API keys are stripped from the CLI's env.
LLM_BACKEND=anthropic
# Optional model for the backend (claude-code: opus, sonnet, haiku or a full id; codex: e.g. gpt-5)
# LLM_MODEL=
# Parallel CLI calls (default 2). Subscriptions have usage caps; keep this and JUDGE_CAP_PER_RUN low.
# LLM_CLI_CONCURRENCY=2
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Where the browser lands after the OAuth callback (success and failure). Local web dev server.
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://wma:wma@localhost:5432/wma
# 32 random bytes, base64. Generate with: openssl rand -base64 32
VAULT_MASTER_KEY=
FILE_STORE_DIR=./data/files
SESSION_SECRET=
# Password for the non-owner application role wma_app (created by the migration)
APP_DB_PASSWORD=wma_app
# Used by the db integration tests (scripts/db-test-reset.sh creates this database)
TEST_DATABASE_URL=postgres://wma:wma@localhost:5432/wma_test
DEMO_LOGIN_TOKEN=
DEMO_FORMS_PORT=4310
WEB_ORIGIN=http://localhost:5173
# Most postings one daily run sends to the model (integer >= 1)
# JUDGE_CAP_PER_RUN=120
# Most roles one daily run applies to at the same company (integer >= 1)
# MAX_PER_COMPANY_PER_RUN=1
